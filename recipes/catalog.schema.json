{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ambassador Local catalog",
  "description": "Every model, lab and workstation the app knows. The app validates it again at build time (cd src-tauri && cargo test).",
  "type": "object",
  "required": [
    "schema",
    "engine",
    "hardware",
    "families",
    "models"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": 1
    },
    "engine": {
      "type": "object"
    },
    "hardware": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "series",
          "description",
          "color"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id",
            "description": "Also the logo file name: src/assets/labs/<id>.svg"
          },
          "name": {
            "type": "string"
          },
          "series": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "featured": {
            "type": "boolean",
            "description": "Recommended lab: shown with a crown. The order of this list is the order on screen."
          }
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,64}$"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "file": {
      "type": "object",
      "required": [
        "url",
        "sha256",
        "size"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://(github\\.com|huggingface\\.co)/",
          "description": "Pin Hugging Face files to a commit: /resolve/<commit>/<file>"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "description": "Bytes"
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "family",
        "name",
        "size",
        "tagline",
        "quant",
        "size_class",
        "intelligence",
        "best_for",
        "files",
        "recipes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "family": {
          "type": "string",
          "description": "Lab id from families"
        },
        "name": {
          "type": "string",
          "description": "Shown in the table, e.g. Gemma 3 12B"
        },
        "size": {
          "type": "string",
          "description": "Parameter count, e.g. 12B"
        },
        "tagline": {
          "type": "string",
          "description": "One short line under the name"
        },
        "quant": {
          "type": "string",
          "description": "e.g. Q4_K_M"
        },
        "size_class": {
          "enum": [
            "small",
            "medium",
            "large",
            "xlarge"
          ],
          "description": "small: 4–14B · medium: 24–32B · large: ~70B, up to 96 GB (RTX PRO 6000) · xlarge: fits in two linked GB10 / DGX Spark"
        },
        "intelligence": {
          "$ref": "#/$defs/rating",
          "description": "1–5 light bulbs: how capable the answers are"
        },
        "best_for": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "description": "1–3 short labels, e.g. Chat, Coding, Agents"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          },
          "description": "GGUF files for llama.cpp. Empty only when every recipe of the model is vllm."
        },
        "recipes": {
          "type": "object",
          "description": "One recipe per workstation id that can run this model",
          "additionalProperties": {
            "$ref": "#/$defs/recipe"
          }
        }
      }
    },
    "recipe": {
      "type": "object",
      "required": [
        "speed",
        "ctx_size"
      ],
      "dependentRequired": {
        "quant": [
          "files"
        ],
        "files": [
          "quant"
        ]
      },
      "additionalProperties": false,
      "properties": {
        "speed": {
          "$ref": "#/$defs/rating",
          "description": "1–5 lightning bolts: how fast it answers on this workstation"
        },
        "tokens_per_sec": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "description": "Average generation speed you measured on this workstation (tokens per second). Leave it out until measured."
        },
        "ctx_size": {
          "type": "integer",
          "minimum": 512,
          "maximum": 1048576,
          "description": "Memory (context) in tokens: llama.cpp -c (up to 262144) or vLLM --max-model-len (up to 1048576)"
        },
        "quant": {
          "type": "string",
          "minLength": 1,
          "description": "A different quantization for this workstation (e.g. Q8 where memory allows). Set together with files."
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          },
          "description": "GGUF files for this workstation's quant. Set together with quant; leave both out to use the model's."
        },
        "mtp": {
          "$ref": "#/$defs/mtp"
        },
        "gpu_layers": {
          "type": "integer",
          "minimum": 0,
          "description": "-ngl, default 999 (all on GPU)"
        },
        "flash_attn": {
          "type": "boolean",
          "description": "-fa on/off, default true"
        },
        "mmap": {
          "type": "boolean",
          "description": "false adds --no-mmap"
        },
        "temp": {
          "type": "number"
        },
        "top_p": {
          "type": "number"
        },
        "top_k": {
          "type": "integer"
        },
        "min_p": {
          "type": "number"
        },
        "vllm": {
          "$ref": "#/$defs/vllm"
        }
      }
    },
    "mtp": {
      "type": "object",
      "description": "Speculative decoding with the model's MTP head (--spec-type draft-mtp): same answers, faster. Leave out for models without MTP.",
      "required": [
        "draft_n_max"
      ],
      "additionalProperties": false,
      "properties": {
        "draft_n_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "description": "Tokens drafted per step, --spec-draft-n-max. Measure 2–4 and keep the fastest."
        },
        "draft": {
          "$ref": "#/$defs/file",
          "description": "Separate GGUF with the MTP head (-md), e.g. mtp-*.gguf. Leave out when the MTP head is inside the model's GGUF."
        }
      }
    },
    "vllm": {
      "type": "object",
      "description": "Serve this model with vLLM in a container instead of llama.cpp. Only for linked GB10 (units 2). The app checks both GB10 before it can run.",
      "required": [
        "image",
        "image_id",
        "repo",
        "revision",
        "size"
      ],
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]*@sha256:[0-9a-f]{64}$",
          "description": "Container image pinned by digest, e.g. eugr/spark-vllm-b12x@sha256:…"
        },
        "image_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "docker image inspect --format '{{.Id}}' of that image. Accepted when the digest is missing (an image copied with docker save/load keeps its id)."
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$",
          "description": "Hugging Face repo with the weights, e.g. nvidia/GLM-5.3-Flash-FP4-Local"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Commit of that repo"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "description": "Bytes of the weights at that revision (each GB10 keeps a copy)"
        }
      }
    }
  }
}
