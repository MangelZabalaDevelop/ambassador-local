# Engine settings read by the MiaAI-Lab 256k launcher inside the image, exactly as the recipe's scripts/serve.sh
# measured them. Passed to the container as they are (docker --env-file: no quotes, no comments after a value).
HF_HOME=/hf-cache
HF_HUB_OFFLINE=1
MODEL_REPO=0xSero/deepseek-v4-flash-0731-spark
MODEL_REVISION=22f28d32b9b29b4352eaa380ff8c2c170b2847ab
MODEL_SOURCE_DIR=/hf-cache/hub/models--0xSero--deepseek-v4-flash-0731-spark/snapshots/22f28d32b9b29b4352eaa380ff8c2c170b2847ab
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=4096
VLLM_DSV4_PADDED_NVFP4=0
KV_FP8_ROPE=0
MODE=dspark
DSPARK_CAPACITY=0
DSPARK_DYNAMIC_DRAFT_DEPTH=0
DSPARK_DYNAMIC_DRAFT_DEPTH_WINDOW=8
REJECTION_SAMPLE_METHOD=standard
DRAFT_SAMPLE_METHOD=probabilistic
DSPARK_DRAFT_EXPERTS=64
DSPARK_STRUCTURED_EXPERTS_PER_CATEGORY=32
VLLM_USE_B12X_WO_PROJECTION=1
VERIFY_MODEL_CHECKSUMS=0
MAX_CUDAGRAPH_CAPTURE_SIZE=6
CUDAGRAPH_CAPTURE_SIZES=6
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
EXTRA_VLLM_ARGS=--long-prefill-token-threshold 4096 --mm-processor-cache-gb 0 --mm-encoder-attn-backend TORCH_SDPA
DEFAULT_CHAT_TEMPLATE_KWARGS_THINKING=true
VLLM_MULTI_STREAM_GEMM_TOKEN_THRESHOLD=4096
KV_OFFLOAD_GB=0
VLLM_USE_SIMPLE_KV_OFFLOAD=0
