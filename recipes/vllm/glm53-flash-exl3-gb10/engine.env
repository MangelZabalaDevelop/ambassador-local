# Engine settings, exactly as the recipe's start.sh passes them (docker --env-file: no quotes, no comments after a value).
GLOO_SOCKET_IFNAME=lo
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
CUTE_DSL_ARCH=sm_121a
EXL3_FUSED_MOE=1
EXL3_MOE_ROW_TILE=0
EXL3_TEMP_ROWS_FUSED=128
EXL3_FAT_SORTED=0
EXL3_FAT_BATCHED=0
EXL3_FAT_KERNEL=1
GLM53_SUPPRESS_STOPS_IN_REASONING=1
GLM53_MIXED_PREFILL_CHUNK=skip
GLM53_INDEXER_WORKSPACE=stock
GLM53_SPINWAIT_MS=stock
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=1800
# Added: the weights are already in the cache, so never reach Hugging Face; allow a slow first boot.
HF_HUB_OFFLINE=1
VLLM_ENGINE_READY_TIMEOUT_S=3600
