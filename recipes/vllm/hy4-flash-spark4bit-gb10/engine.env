# Engine settings, exactly as Tencent's README_SPARK-4Bit.md sets them for Linux (docker --env-file: no quotes, no
# comments after a value). Each one turns on a GB10 kernel path of their patch when the tensor shapes match.
GGML_SCHED_BATCH_HOST_INPUTS=0
GGML_CUDA_FUSE_HC_GATE=1
GGML_CUDA_FUSE_HC_CONSUMER=1
GGML_CUDA_REUSE_Q8=1
GGML_CUDA_SPARK_MMQ_FUSION=1
GGML_CUDA_SPARK_MMQ_COMPACT_GRID=1
GGML_CUDA_SPARK_MMQ_TILE=64
GGML_CUDA_SPARK_MMQ_TILE_FUSED=64
GGML_CUDA_MMQ_PREC=q4
GGML_CUDA_CPY_F32_VEC=1
GGML_CUDA_SPARK_MMVQ_2W=1
GGML_CUDA_MOE_CONCURRENT=1
GGML_CUDA_FA_576_WHOLE_TILES=0
