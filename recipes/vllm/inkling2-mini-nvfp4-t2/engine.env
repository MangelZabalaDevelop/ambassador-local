# Engine settings from SGLang's verified RTX PRO 6000 DSpark recipe for Inkling 2 Mini. Passed to the container as
# they are (docker --env-file: no quotes, no comments after a value).
SGLANG_OPT_INKLING2_VERIFY_REL_BIAS_KERNEL=1
SGLANG_OPT_DSV41_DSPARK_MID_FOLD=1
SGLANG_OPT_DSV41_DSPARK_PREPARE_INPUTS_ONCE=1
SGLANG_OPT_DSV41_DSPARK_SKIP_PREFILLED_INPUTS=1
HF_HUB_OFFLINE=1
